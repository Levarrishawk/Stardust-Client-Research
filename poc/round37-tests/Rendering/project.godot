[application]
config/name="Synthetic Circle Height Patch"
run/main_scene="res://TerrainCircleHeightPreview.tscn"
[display]
window/size/viewport_width=640
window/size/viewport_height=480
[dotnet]
project/assembly_name="CircleHeightProof"
[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0,0,0,1)
